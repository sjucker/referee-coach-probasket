{
  "name": "webapp",
  "version": "1.12.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy-config.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "release": "release-it"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.5",
    "@angular/material-luxon-adapter": "22.2.5",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/youtube-player": "22.2.5",
    "file-saver": "2.0.5",
    "luxon": "3.7.2",
    "release-it": "21.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/luxon": "3.7.6",
    "angular-eslint": "22.6.0",
    "baseline-browser-mapping": "2.11.34",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
